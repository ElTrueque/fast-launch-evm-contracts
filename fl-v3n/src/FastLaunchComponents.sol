import {FastLaunchSplitter, IPoolManager, PoolKey} from "./FastLaunchSplitter.sol";
import {FastLaunchHolderRewards} from "./FastLaunchHolderRewards.sol";

/// @title Fast Launch by El Trueque
/// @author El Trueque
/// @notice Immutable deployment helper keeps factory runtime below EIP-170. No delegatecall.
contract FastLaunchComponents {
    address public immutable factory;

    constructor() {
        factory = msg.sender;
    }

    function deploy(
        IPoolManager manager,
        PoolKey memory key,
        address token,
        address quote,
        address creator,
        address treasury,
        int24 lower,
        int24 upper,
        uint128 liquidity,
        bool toHolders,
        address snapshotSigner
    ) external returns (address splitter, address rewards) {
        require(msg.sender == factory);
        if (toHolders) {
            rewards = address(new FastLaunchHolderRewards(token, quote, address(manager), factory, snapshotSigner));
        }
        splitter = address(
            new FastLaunchSplitter(
                manager,
                key,
                token,
                quote,
                creator,
                treasury,
                lower,
                upper,
                liquidity,
                factory,
                toHolders ? rewards : creator
            )
        );
        if (toHolders) FastLaunchHolderRewards(payable(rewards)).bindSplitter(splitter);
    }
}
