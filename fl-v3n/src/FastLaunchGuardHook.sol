import {IHooks} from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import {PoolKey} from "@uniswap/v4-core/src/types/PoolKey.sol";

/// @title Fast Launch by El Trueque · creation guard (v2)
/// @author El Trueque
/// @notice Only the Fast Launch factory can initialize pools that use this hook, so nobody can create
/// a pool with it at another price. It has no other permission: swaps, liquidity and donations behave
/// exactly like a pool without hooks, and the LP fee is the static fee written in the pool key.
contract FastLaunchGuardHook {
    /// @dev Address bits for BEFORE_INITIALIZE only (Uniswap v4 Hooks.BEFORE_INITIALIZE_FLAG = 1 << 13).
    uint160 public constant FLAGS = 0x2000;
    address public immutable manager;
    address public immutable factory;

    error Unauthorized();
    error InvalidHookAddress();

    constructor(address manager_, address factory_) {
        if (uint160(address(this)) & 0x3fff != FLAGS) revert InvalidHookAddress();
        manager = manager_;
        factory = factory_;
    }

    function beforeInitialize(address sender, PoolKey calldata, uint160) external view returns (bytes4) {
        if (msg.sender != manager || sender != factory) revert Unauthorized();
        return IHooks.beforeInitialize.selector;
    }
}
